---
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Yeabsra Ashebir">
	<div class="space-y-8">
		<section>
			<div class="flex items-start gap-8 mb-6">
				<img
					src="https://media.licdn.com/dms/image/v2/D5603AQHbde3s8V_RfQ/profile-displayphoto-shrink_800_800/B56ZWQFOgXHoAk-/0/1741879063054?e=1751500800&v=beta&t=AzIlgQd7495otPLc_cTpHfYHfFbdqb_yMTDhCA4WM4g"
					alt="Yeabsra Ashebir"
					class="shadow-lg rounded-lg w-32 h-32 object-cover"
				/>
				<div class="space-y-2">
					<h1 class="terminal-prompt">Yeabsra Ashebir</h1>
					<p class="text-muted">
						<span class="text-accent">$</span> cat about.md
					</p>
					<div class="ml-4">
						<p>Full Stack Developer | web developer | mobile developer</p>
					</div>
				</div>
			</div>

			<div class="p-4 card">
				<h3 class="mb-3 font-semibold text-lg">About Me</h3>
				<p class="text-muted">
					Hey! I&apos;m a full-stack developer who loves building things that actually make a difference. I work on both web and mobile stuff, and I enjoy jumping between frontend and backend—whether it&apos;s making a slick UI or setting up a solid backend system. Lately, I&apos;ve been diving into everything from DevOps to AI agents. I&apos;m always experimenting with new tools, building projects, and sharing what I learn along the way. Basically, if there&apos;s an idea worth building, I&apos;m all in.	
				</p>
			</div>
		</section>

		<section>
			<p class="mb-2 text-muted">
				<span class="text-accent">$</span> ls ./contact
			</p>
			<div class="flex flex-wrap gap-2 ml-4">
				<button
					data-cal-link="cal.com/technerd345/15min"
					data-cal-namespace="15min"
					data-cal-config='{"layout":"month_view"}'
					class="btn"
				>
					<Icon name="calendar" class="w-3.5 h-3.5" />
					calendar.sh
				</button>
				<a href="https://github.com/yeabnoah" target="_blank" class="btn">
					<Icon name="github" class="w-3.5 h-3.5" />
					github.md
				</a>
				<a href="mailto:yeabnoah5@gmail.com" class="btn">
					<Icon name="mail" class="w-3.5 h-3.5" />
					mail.txt
				</a>
				<a href="https://x.com/technerd556" target="_blank" class="btn">
					<Icon name="x" class="w-3.5 h-3.5" />
					x.md
				</a>
				<a
					href="https://www.linkedin.com/in/yeabsra-ashebir-tech-nerd-8a3a80267/"
					target="_blank"
					class="btn"
				>
					<Icon name="linkedin" class="w-3.5 h-3.5" />
					linkedin.md
				</a>
			</div>
		</section>
	</div>
</Layout>

<!-- Cal.com Embed -->
<script is:inline>
	;(function (C, A, L) {
		let p = function (a, ar) {
			a.q.push(ar)
		}
		let d = C.document
		C.Cal =
			C.Cal ||
			function () {
				let cal = C.Cal
				let ar = arguments
				if (!cal.loaded) {
					cal.ns = {}
					cal.q = cal.q || []
					d.head.appendChild(d.createElement('script')).src = A
					cal.loaded = true
				}
				if (ar[0] === L) {
					const api = function () {
						p(api, arguments)
					}
					const namespace = ar[1]
					api.q = api.q || []
					if (typeof namespace === 'string') {
						cal.ns[namespace] = cal.ns[namespace] || api
						p(cal.ns[namespace], ar)
						p(cal, ['initNamespace', namespace])
					} else p(cal, ar)
					return
				}
				p(cal, ar)
			}
	})(window, 'https://app.cal.com/embed/embed.js', 'init')
	Cal('init', '15min', { origin: 'https://cal.com' })

	Cal.ns['15min']('ui', {
		theme: 'auto',
		styles: { branding: { brandColor: '#89b4fa' } },
		hideEventTypeDetails: false,
		layout: 'month_view'
