---
import Badge from '../components/Badge.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Skills | Yeabsra Ashebir">
  <div class="space-y-4 md:space-y-6">
    <div class="p-3 md:p-4 card">
      <h3 class="mb-2 md:mb-3 font-medium text-accent text-base md:text-lg">Frontend Development</h3>
      <div class="space-y-2 md:space-y-3">
        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Frameworks & Libraries</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="React.js" />
            <Badge name="Astro.js" />
            <Badge name="Tanstack Router" />
            <Badge name="Next.js" />
            <Badge name="Remix" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Styling</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Tailwind CSS" />
            <Badge name="ShadCN UI" />
            <Badge name="Sass" />
            <Badge name="CSS Modules" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">State Management</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Redux" />
            <Badge name="Zustand" />
            <Badge name="Tanstack Query" />
            <Badge name="Recoil" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Animation & UI</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Framer Motion" />
            <Badge name="Radix UI" />
            <Badge name="GSAP" />
            <Badge name="Lottie" />
            <Badge name="Three.js" />

          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Tooling</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="TypeScript" />
            <Badge name="Vite" />
            <Badge name="PNPM" />
            <Badge name="Biome" />
            <Badge name="ESLint" />
            <Badge name="Prettier" />
            <Badge name="Storybook" />
            <Badge name="Bun" />
            <Badge name="Jest" />
            <Badge name="Cypress" />

          </div>
        </div>
      </div>
    </div>

    <div class="p-3 md:p-4 card">
      <h3 class="mb-2 md:mb-3 font-medium text-accent text-base md:text-lg">Backend Development</h3>
      <div class="space-y-2 md:space-y-3">
        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Languages & Runtimes</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Node.js" />
            <Badge name="TypeScript" />
            <Badge name="Go" />
            <Badge name="Python" />
            <Badge name="PHP" />
          </div>
        </div>


        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Frameworks</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Express.js" />
            <Badge name="NestJS" />
            <Badge name="Hono.js" />
            <Badge name="FastAPI" />
            <Badge name="Elisya" />
            <Badge name="NextAPI" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Database & ORM</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="PostgreSQL" />
            <Badge name="SQLite" />
            <Badge name="Prisma" />
            <Badge name="MongoDB" />
            <Badge name="Mongoose" />
            <Badge name="Drizzle" />
            <Badge name="Supabase" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">APIs & Communication</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="REST" />
            <Badge name="GraphQL" />
            <Badge name="WebSocket" />
            <Badge name="Socket.IO" />
            <Badge name="Trpc" />
          </div>
        </div>
      </div>
    </div>

    <div class="p-3 md:p-4 card">
      <h3 class="mb-2 md:mb-3 font-medium text-accent text-base md:text-lg">DevOps & Infrastructure ( * learning !! )</h3>
      <div class="space-y-2 md:space-y-3">
        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Containers & Orchestration</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Docker" />
            <Badge name="Kubernetes *" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">IaC & Configuration</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="Terraform *" />
            <Badge name="Helm *" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">CI/CD & Monitoring</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="GitHub Actions" />
            <Badge name="ArgoCD *" />
            <Badge name="Prometheus *" />
            <Badge name="Grafana *" />
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Cloud & Infrastructure</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="AWS" />
            <Badge name="GCP" />
            <Badge name="Linux" />
            <Badge name="Bash" />
          </div>
        </div>
      </div>
    </div>

    <div class="p-3 md:p-4 card">
      <h3 class="mb-2 md:mb-3 font-medium text-accent text-base md:text-lg">Mobile Development</h3>
      <div class="space-y-2 md:space-y-3">
        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">Frameworks & Tools</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="React Native" />
            <Badge name="Expo" />
            <Badge name="Android Studio" />
            <Badge name="Xcode" />
            
          </div>
        </div>

        <div>
          <p class="mb-1 text-muted text-xs md:text-sm">State & Navigation</p>
          <div class="flex flex-wrap gap-1">
            <Badge name="React Navigation" />
            <Badge name="Zustand" />
            <Badge name="Redux" />
            <Badge name="Tanstack Query" />
            <Badge name="Expo Router" />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout> 