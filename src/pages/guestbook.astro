---
export const prerender = false

import { actions } from 'astro:actions'
import GuestbookEntries from '../components/GuestbookEntries.astro'
import Layout from '../layouts/Layout.astro'

const result = Astro.getActionResult(actions.guestbook)

if (result?.error) {
	console.error(result.error)
}
---

<Layout title="Guestbook | Yeabsra Ashebir">
	<div class="space-y-6">
		<form
			method="POST"
			action={actions.guestbook}
			class="gap-4 grid grid-cols-1 md:grid-cols-[1fr_2fr_auto]"
		>
			<input type="text" name="name" placeholder="Name" required class="p-2" />
			<input type="text" name="message" placeholder="Message" required class="p-2" />
			<button type="submit" class="px-4 py-2 btn">Sign</button>
		</form>
		<GuestbookEntries server:defer>
			<div slot="fallback" class="space-y-3">
				<div class="bg-soft rounded-sm w-3/4 h-4 animate-pulse"></div>
				<div class="bg-soft rounded-sm w-2/3 h-4 animate-pulse"></div>
				<div class="bg-soft rounded-sm w-4/5 h-4 animate-pulse"></div>
				<div class="bg-soft rounded-sm w-3/5 h-4 animate-pulse"></div>
			</div>
		</GuestbookEntries>
	</div>
</Layout>
