---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import Badge from '../../components/Badge.astro'
import Layout from '../../layouts/Layout.astro'
import { projects } from '../../lib/projects'
import type { Project } from '../../lib/types'

export function getStaticPaths() {
	return projects.flatMap((project) => ({
		params: {
			project: project.alias
		}
	}))
}

const { project } = Astro.params

const { name, description, githubLink, liveLink, alias, techUsed }: Project = projects.find(
	(p) => p.alias === project
)!
---

<Layout title={`${name} | Yeabsra Ashebir`}>
	<div transition:name={`${alias}`} class="space-y-6">
		<div class="space-y-4">
			<div class="flex justify-between items-center">
				<h1 class="text-foreground">{name}</h1>
			</div>

			<p class="text-muted">{description}</p>

			{
				techUsed && techUsed.length > 0 && (
					<div class="space-y-2">
						<h3 class="font-medium text-sm">Technologies</h3>
						<div class="flex flex-wrap gap-2">
							{techUsed.map((tech) => (
								<Badge name={tech.name} />
							))}
						</div>
					</div>
				)
			}

			<div class="flex sm:flex-row flex-col gap-2 pt-2">
				{
					liveLink && (
						<a href={liveLink} class="btn" target="_blank">
							<Icon name="external" class="w-3.5 h-3.5" />
							View Live
						</a>
					)
				}
				<a href={githubLink} class="btn" target="_blank">
					<Icon name="github" class="w-3.5 h-3.5" />
					View on GitHub
				</a>
			</div>
		</div>
	</div>
</Layout>
