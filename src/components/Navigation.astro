---
const navItems = [
	{ name: 'About', href: '/' },
	{ name: 'Projects', href: '/projects' },
	{ name: 'Skills', href: '/skills' },
	{ name: 'Blog', href: '/blog' }
]

const currentPath = Astro.url.pathname
---

<nav class="top-0 z-50 sticky bg-background/80 backdrop-blur-sm mb-8 border-b border-border">
	<div class="mx-auto px-4 py-3 max-w-3xl">
		<ul class="flex gap-6">
			{
				navItems.map(({ name, href }) => (
					<li>
						<a
							href={href}
							class={`text-sm transition-colors ${
								currentPath === href
									? 'text-accent font-medium'
									: 'text-muted hover:text-foreground'
							}`}
						>
							{name}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

